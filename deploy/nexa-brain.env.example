# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexaprospero
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=1.2
NEXA_BRAIN_REDIS_STREAM=nexa:brain:events
NEXA_BRAIN_STREAM_MAXLEN=20000
NEXA_BRAIN_CACHE_TTL=300
NEXA_BRAIN_OUTBOX_STRICT=0
NEXA_SLOW_REQUEST_MS=1200

# WebSocket multiempresa
NEXA_BRAIN_WS_HOST=127.0.0.1
NEXA_BRAIN_WS_PORT=8081
NEXA_BRAIN_WS_PATH=/brain-ws
NEXA_BRAIN_WS_SECRET=GERAR_COM_OPENSSL_RAND_HEX_32
NEXA_BRAIN_WS_URL=auto
NEXA_BRAIN_WS_ROOT_DOMAIN=nexaprospero.com.br
NEXA_BRAIN_ALLOWED_ORIGINS=https://*.nexaprospero.com.br
